@startuml
!pragma horizontalLineBetweenDifferentPackageAllowed
' Statut : DRAFT
' Vue logique limitée ; aucun détail de déploiement.
title Composants applicatifs V1 — DRAFT
top to bottom direction
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam componentStyle uml2
skinparam linetype polyline
skinparam nodesep 60
skinparam ranksep 75
rectangle "Système de gestion des demandes techniques" as SYSTEM {
  component "Angular SPA" as SPA
  rectangle "Spring Boot — monolithe modulaire" as BACKEND {
    component "Security" as SECURITY
    component "Request" as REQUEST
    component "Identity / Administration" as IDENTITY
    interface "AnalyseIaPort" as AI_CONTRACT
    component "ai.groq" as AI
  }
  database "PostgreSQL" as POSTGRES
}
rectangle "Groq API\n« système externe »" as GROQ
SPA .right.> SECURITY : authentification
SPA .right.> REQUEST : fonctions métier
SPA .right.> IDENTITY : administration
SECURITY .right.> IDENTITY : identités et rôles
REQUEST .right.> IDENTITY : utilisateurs liés
REQUEST .down.> AI_CONTRACT : assistance IA
AI .left.|> AI_CONTRACT
AI .down.> GROQ
REQUEST .down.> POSTGRES
IDENTITY .down.> POSTGRES
' Contraintes graphiques uniquement.
SPA -[hidden]right-> SECURITY
SECURITY -[hidden]right-> IDENTITY

SECURITY -[hidden]down- REQUEST
REQUEST -[hidden]right-> IDENTITY
IDENTITY -[hidden]down-> POSTGRES

SYSTEM -[hidden]right-> GROQ

@enduml
