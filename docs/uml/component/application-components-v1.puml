@startuml
!pragma horizontalLineBetweenDifferentPackageAllowed
' Statut : DRAFT
' Vue d'architecture logique limitée ; aucun détail de déploiement.
' Service d'identité : contrat applicatif de la classe IdentiteService, pas une interface Java.
' Persistance JPA : accès applicatif via Spring Data JPA/Hibernate à PostgreSQL.
' PostgreSQL est le système de persistance ; il ne fournit pas l'API JPA.
' Le Port/Adapter concerne uniquement l'intégration IA.
title Composants applicatifs V1 — DRAFT
top to bottom direction
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam componentStyle uml2
skinparam defaultFontSize 18
skinparam ArrowFontSize 16
skinparam titleFontSize 22
skinparam linetype ortho
skinparam nodesep 150
skinparam ranksep 100
<style>
component {
 HorizontalAlignment center
 MinimumWidth 240
 .wide { MinimumWidth 760 }
}
</style>
hide stereotype
rectangle "Système de gestion des demandes techniques" as SYSTEM {
  component "Angular SPA" as SPA <<wide>>
  rectangle "Spring Boot — monolithe modulaire" as BACKEND #line:transparent;back:F7F7F7 {
    component "Sécurité" as SECURITY
    component "Identité / Administration" as IDENTITY
    component "Gestion des demandes" as REQUEST
    component "Adaptateur IA Groq" as AI
  }
  database "PostgreSQL" as POSTGRES
}
rectangle "Groq API\n« système externe »" as GROQ
' Carrés sur cadres : ports UML ; socket consommateur, cercle fournisseur.
SPA #-down(0-# SECURITY : API Authentification
SPA #-down(0-# REQUEST : API Demandes\n\n<size:1> </size>
SPA #-down(0-# IDENTITY : API Administration
IDENTITY #-left0)-# SECURITY : Service d'identité
REQUEST #-up(0-# IDENTITY : Service d'identité
REQUEST #-down(0-# AI : AnalyseIaPort
AI #-right(0-# GROQ : API Groq\n\n<size:1> </size>
POSTGRES #-[norank]0)-# REQUEST : Persistance JPA
POSTGRES #-[norank]0)-# IDENTITY : Persistance JPA
' Contraintes graphiques uniquement, sans relation sémantique supplémentaire.
POSTGRES -[hidden]right-> AI
@enduml
