@startuml
' Statut : DRAFT
' Niveau : conception technique ; vue synthétique du code main 7a6438d
' Les associations dirigées représentent les références injectées conservées.
title Classes de conception backend V1 — DRAFT
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 18
skinparam ranksep 28
hide empty members
package request {
  class DemandeController <<presentation>>
  class DemandeService <<application>>
  class AnalyseIaService <<application>>
  interface AnalyseIaPort <<application>>
  interface DemandeTechniqueRepository <<persistence>>
  interface ClientRepository <<persistence>>
  class DemandeTechnique <<domain>>
  class Client <<domain>>
  class HistoriqueDemande <<domain>>
    class CreationDemandeRequest <<DTO HTTP>>
    class DemandeDetailResponse <<DTO HTTP>>
  DemandeController --> DemandeService
  DemandeController --> AnalyseIaService
  DemandeController ..> CreationDemandeRequest
  DemandeController ..> DemandeDetailResponse
  DemandeService --> DemandeTechniqueRepository
  DemandeService --> ClientRepository
  DemandeTechniqueRepository ..> DemandeTechnique
  ClientRepository ..> Client
  DemandeTechnique --> Client : client
  DemandeTechnique -- HistoriqueDemande : historique / demande
  AnalyseIaService --> AnalyseIaPort
}
package identity {
  class UtilisateurController <<presentation>>
  class IdentiteService <<application>>
  interface UtilisateurRepository <<persistence>>
  class Utilisateur <<domain>>
  class CreationUtilisateurRequest <<DTO HTTP>>
  class UtilisateurDetailResponse <<DTO HTTP>>
  UtilisateurController --> IdentiteService
  UtilisateurController ..> CreationUtilisateurRequest
  UtilisateurController ..> UtilisateurDetailResponse
  IdentiteService --> UtilisateurRepository
  UtilisateurRepository ..> Utilisateur
}
package security {
  class AuthController <<presentation>>
  class AuthenticationService <<application>>
  class AuthentificationResultat <<application>>
  class LoginRequest <<DTO HTTP>>
  class LoginResponse <<DTO HTTP>>
  class JwtService <<jwt>>
  AuthController --> AuthenticationService
  AuthenticationService --> JwtService
  AuthenticationService ..> AuthentificationResultat
  AuthController ..> AuthentificationResultat
  AuthController ..> LoginRequest
  AuthController ..> LoginResponse
}
package "ai.groq" as GROQ_MODULE {
  class GroqAnalyseIaAdapter <<adaptateur>>
}
DemandeService -down-> IdentiteService
AuthenticationService -right-> IdentiteService
GroqAnalyseIaAdapter .up.|> AnalyseIaPort
CreationDemandeRequest -[hidden]down- DemandeDetailResponse
CreationUtilisateurRequest -[hidden]down- UtilisateurDetailResponse
LoginRequest -[hidden]down- LoginResponse
legend bottom
  Vue représentative : attributs, méthodes triviales et classes secondaires omis.
  Trait continu : association structurelle ; pointillé : usage ; triangle : réalisation.
  Port/adaptateur limité à la frontière IA ; aucun Mapper autonome dans le code.
endlegend
@enduml
