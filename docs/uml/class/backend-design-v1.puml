@startuml
' Statut : DRAFT
' Vue synthétique des classes réelles de main ; détails omis volontairement.
' Les liens hidden sont uniquement des contraintes graphiques.
title Conception backend V1 — DRAFT
top to bottom direction
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 22
skinparam ranksep 30
hide empty members
hide circle
package request as REQUEST_MODULE {
  class CreationDemandeRequest <<DTO>>
  class DemandeController <<Controller>>
  class DemandeService <<Service>>
  interface DemandeTechniqueRepository <<Repository>>
  class DemandeTechnique <<Entity>>
  class AnalyseIaService <<Service>>
  interface AnalyseIaPort <<Port>>
  DemandeController .up.> CreationDemandeRequest
  DemandeController -down-> DemandeService
  DemandeService -down-> DemandeTechniqueRepository
  DemandeTechniqueRepository .down.> DemandeTechnique
  DemandeController -left-> AnalyseIaService
  AnalyseIaService -down-> AnalyseIaPort
}
package "ai.groq" as GROQ_MODULE {
  class GroqAnalyseIaAdapter <<Adapter>>
}
GroqAnalyseIaAdapter .up.|> AnalyseIaPort
package identity as IDENTITY_MODULE {
  class CreationUtilisateurRequest <<DTO>>
  class UtilisateurController <<Controller>>
  class IdentiteService <<Service>>
  interface UtilisateurRepository <<Repository>>
  class Utilisateur <<Entity>>
  UtilisateurController .up.> CreationUtilisateurRequest
  UtilisateurController -down-> IdentiteService
  IdentiteService -down-> UtilisateurRepository
  UtilisateurRepository .down.> Utilisateur
}
package security as SECURITY_MODULE {
  class LoginRequest <<DTO>>
  class LoginResponse <<DTO>>
  class AuthController <<Controller>>
  class AuthenticationService <<Service>>
  class AuthentificationResultat <<Result>>
  class JwtService <<Service>>
  AuthController .up.> LoginRequest
  AuthController .up.> LoginResponse
  AuthController -down-> AuthenticationService
  AuthController .right.> AuthentificationResultat
  AuthenticationService .right.> AuthentificationResultat
  AuthenticationService -down-> JwtService
}
DemandeService -up-> IdentiteService
AuthenticationService -up-> IdentiteService
' Placement uniquement : alignement des entrées et services.
LoginRequest -[hidden]right- LoginResponse
DemandeController -[hidden]right-> AuthController
@enduml
