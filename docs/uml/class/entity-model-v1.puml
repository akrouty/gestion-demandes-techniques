@startuml
' Statut : DRAFT
' Niveau : modèle de données ; mappings JPA et V1__initial_schema.sql (main 7a6438d)
title Diagramme des entités persistantes / modèle de données V1 — DRAFT
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam nodesep 50
skinparam ranksep 140
skinparam linetype ortho
hide methods
class Utilisateur <<entité JPA>> {
  id : Long {PK, SEQUENCE}
  nom : String
  email : String {unique, normalisé}
  actif : boolean
  passwordHash : String
  roles : Role [0..*] {unique}
}
class Client <<entité JPA>> {
  id : Long {PK, SEQUENCE}
  nom : String
  email : String
  telephone : String
}
class DemandeTechnique <<entité JPA>> {
  id : Long {PK, SEQUENCE}
  reference : String {unique, immuable}
  titre : String
  description : String
  categorie : Categorie
  priorite : Priorite
  statut : StatutDemande
  descriptionTraitement : String [0..1]
  solution : String [0..1]
  motifAnnulation : String [0..1]
  dateCreation : Instant
  dateModification : Instant
  dateResolution : Instant [0..1]
  dateCloture : Instant [0..1]
  dateAnnulation : Instant [0..1]
}
class HistoriqueDemande <<entité JPA>> {
  id : Long {PK, SEQUENCE}
  dateEvenement : Instant
  typeEvenement : String
  ancienneValeur : String [0..1]
  nouvelleValeur : String [0..1]
}
enum Role {
  RESPONSABLE_TECHNIQUE
  AGENT_TECHNIQUE
  ADMINISTRATEUR
}
enum Categorie {
  ETUDE_DANGERS
  ANALYSE_RISQUES_INDUSTRIELS
  PROTECTION_INCENDIE
  NOTE_CALCUL
  DOSSIER_TECHNIQUE
  ASSISTANCE_REGLEMENTAIRE
  AUTRE
}
enum Priorite {
  BASSE
  MOYENNE
  HAUTE
  CRITIQUE
}
enum StatutDemande {
  NOUVELLE
  ASSIGNEE
  EN_COURS
  RESOLUE
  CLOTUREE
  ANNULEE
}
Role -[hidden]down-> Categorie
Role -[hidden]right-> Priorite
Categorie -[hidden]right-> StatutDemande
DemandeTechnique "0..*" -up-> "1" Client : client
DemandeTechnique "0..*" -down-> "1" Utilisateur : \ncreateur
DemandeTechnique "0..*" -down-> "0..1" Utilisateur : agentAffecte
HistoriqueDemande "0..*" -down-> "1" Utilisateur : auteur
DemandeTechnique "1" -right- "0..*" HistoriqueDemande : historique / demande\n
note bottom of Utilisateur
  roles : @ElementCollection
  Table utilisateur_role :
  table technique, pas une entité JPA.
end note

' Placement des enums uniquement, sans dépendance sémantique.
Utilisateur -[hidden]down-> Role
@enduml
