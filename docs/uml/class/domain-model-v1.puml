@startuml

' Statut : VALIDATED
title Diagramme de classes métier - V1\nVALIDATED

hide methods
skinparam classAttributeIconSize 0

class Utilisateur {
  id
  nom : String
  email : String
  actif : Boolean
  roles : Role [0..*]
}

class Client {
  id
  nom : String
  email : String
  telephone : String
}

class DemandeTechnique {
  id
  reference : String
  titre : String
  description : String
  categorie : Categorie
  priorite : Priorite
  statut : StatutDemande
  descriptionTraitement : String [0..1]
  solution : String [0..1]
  motifAnnulation : String [0..1]
  dateCreation : DateTime
  dateModification : DateTime
  dateResolution : DateTime [0..1]
  dateCloture : DateTime [0..1]
  dateAnnulation : DateTime [0..1]
}

class HistoriqueDemande {
  id
  dateEvenement : DateTime
  typeEvenement : String
  ancienneValeur : String [0..1]
  nouvelleValeur : String [0..1]
}

enum Role {
  RESPONSABLE_TECHNIQUE
  AGENT_TECHNIQUE
  ADMINISTRATEUR
}

enum StatutDemande {
  NOUVELLE
  ASSIGNEE
  EN_COURS
  RESOLUE
  CLOTUREE
  ANNULEE
}

enum Priorite {
  BASSE
  MOYENNE
  HAUTE
  CRITIQUE
}

enum Categorie {
  Étude de dangers
  Analyse de risques industriels
  Protection incendie
  Note de calcul
  Dossier technique
  Assistance réglementaire
  Autre
}

Client "1" -- "0..*" DemandeTechnique : concerne
Utilisateur "1" -- "0..*" DemandeTechnique : créée par\n{créateur avec rôle RESPONSABLE_TECHNIQUE}
Utilisateur "0..1" -- "0..*" DemandeTechnique : agent affecté\n{agent avec rôle AGENT_TECHNIQUE}
DemandeTechnique "1" *-- "0..*" HistoriqueDemande : historique
Utilisateur "1" -- "0..*" HistoriqueDemande : effectué par

Utilisateur ..> Role : utilise
DemandeTechnique ..> Categorie : utilise
DemandeTechnique ..> Priorite : utilise
DemandeTechnique ..> StatutDemande : utilise

@enduml
