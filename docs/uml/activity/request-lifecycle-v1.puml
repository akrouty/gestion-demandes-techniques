@startuml

' ============================================================
' Diagramme d'activité - Cycle de vie d'une demande - V1
' Statut : VALIDATED
' ============================================================

title Cycle de vie d'une demande - V1\nVALIDATED

skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam activity {
  BackgroundColor white
  BorderColor black
  FontColor black
  DiamondBackgroundColor white
  DiamondBorderColor black
  ArrowColor black
  StartColor black
  EndColor black
}

|Responsable technique|
start
:Renseigner les informations\nde la demande;
if (Utiliser l'IA ?) then (~[Utilisation IA demandée~])
  :Déclencher l'analyse IA;
  |Système|
  if (Analyse IA réussie ?) then (~[Analyse réussie~])
    :Proposer une catégorie\net une priorité;
  else (~[Analyse échouée ou indisponible~])
  endif
  |Responsable technique|
else (~[else~])
endif
:Définir ou valider la catégorie\net la priorité;
:Enregistrer la demande;

|Système|
:Définir le statut\n**NOUVELLE**;

|Responsable technique|
if (Annulation demandée ?) then (~[Annulation demandée~])
  :Renseigner le motif d'annulation;
  |Système|
  :Définir le statut\n**ANNULEE**;
  stop
else (~[else~])
  |Responsable technique|
  :Affecter la demande\nà un Agent technique;
  |Système|
  :Définir le statut\n**ASSIGNEE**;
endif

repeat
  |Responsable technique|
  if (Annulation demandée ?) then (~[Annulation demandée~])
    :Renseigner le motif d'annulation;
    |Système|
    :Définir le statut\n**ANNULEE**;
    stop
  else (~[else~])
  endif

  |Responsable technique|
  if (Réaffectation demandée ?) then (~[Réaffectation demandée~])
    :Réaffecter la demande\nà un autre Agent technique;
    |Système|
    if (Statut avant réaffectation ?) then (~[ASSIGNEE~])
      :Conserver le statut\n**ASSIGNEE**;
    else (~[EN_COURS~])
      :Définir le statut\n**ASSIGNEE**;
    endif
  else (~[else~])
    |Système|
    if (Statut de la demande ?) then (~[ASSIGNEE~])
      |Agent technique|
      :Commencer le traitement;
      |Système|
      :Définir le statut\n**EN_COURS**;
    else (~[EN_COURS~])
      |Agent technique|
      :Poursuivre ou reprendre le traitement;
      :Renseigner la description\ndu traitement et la solution;
      :Déclarer la demande résolue;
      |Système|
      :Définir le statut\n**RESOLUE**;

      |Responsable technique|
      :Examiner la demande résolue;
      if (Résolution acceptée ?) then (~[Résolution acceptée~])
        |Système|
        :Définir le statut\n**CLOTUREE**;
        stop
      else (~[Résolution refusée~])
        |Système|
        :Définir le statut\n**EN_COURS**;
      endif
    endif
  endif
repeat while (Demande active ?) is (~[ASSIGNEE ou EN_COURS~]) not (~[else~])
stop

@enduml
