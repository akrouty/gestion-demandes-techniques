@startuml

' Statut : VALIDATED
title Examiner une demande résolue - V1\nVALIDATED

hide footbox
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam sequence {
  ArrowColor black
  ActorBorderColor black
  ActorBackgroundColor white
  ActorFontColor black
  ParticipantBorderColor black
  ParticipantBackgroundColor white
  ParticipantFontColor black
  LifeLineBorderColor black
  LifeLineBackgroundColor white
  GroupBorderColor black
  GroupHeaderFontColor black
  GroupBodyBackgroundColor white
}

actor "Responsable technique" as RT
participant "Système de gestion\ndes demandes techniques" as SYSTEM

RT -> SYSTEM : Examiner la demande RESOLUE
activate SYSTEM
SYSTEM --> RT : Présenter la demande et sa solution
deactivate SYSTEM

alt Résolution acceptée
  RT -> SYSTEM : Accepter la résolution
  activate SYSTEM
  SYSTEM --> RT : Demande clôturée ; statut CLOTUREE
  deactivate SYSTEM
else Résolution refusée
  RT -> SYSTEM : Refuser la résolution
  activate SYSTEM
  SYSTEM --> RT : Demande remise en traitement ; statut EN_COURS
  deactivate SYSTEM
end

@enduml
