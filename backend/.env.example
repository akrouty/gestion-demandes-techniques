# Configuration locale : copier en .env et remplir les deux secrets.
# Format KEY=VALUE, sans expansion de variables ni commentaires en fin de ligne.
JAVA_HOME=
DB_URL=jdbc:postgresql://localhost:5432/gestion_demandes
DB_USERNAME=postgres
DB_PASSWORD=
JWT_SECRET=
JWT_ISSUER=gestion-demandes-local
JWT_TTL=PT30M
JWT_ALGORITHM=HS256
PASSWORD_MIN_LENGTH=12
BCRYPT_STRENGTH=10
CORS_ALLOWED_ORIGINS=http://localhost:4200

# IA Groq optionnelle : laisser GROQ_API_KEY vide desactive seulement l'analyse IA.
# Renseigner la cle reelle uniquement dans backend/.env local, jamais versionne.
# PT30S est un exemple DEV, pas une valeur de repli dans l'application.
GROQ_API_KEY=
GROQ_TIMEOUT=PT30S
